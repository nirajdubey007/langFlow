# PostgreSQL Configuration
POSTGRES_USER=langflow
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!@#
POSTGRES_DB=langflow

# Langflow Admin Configuration
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD_456!@#

# Security Settings
LANGFLOW_AUTO_LOGIN=false
DO_NOT_TRACK=true

# Secret Key - Generate with: openssl rand -hex 32
LANGFLOW_SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY

# CORS Configuration
# For single domain: https://yourdomain.com
# For multiple domains: https://yourdomain.com,https://app.yourdomain.com
# For development: *
LANGFLOW_CORS_ORIGINS=https://yourdomain.com

